# Copy to .env and fill in. All optional — scrapers skip sources they can't reach.
YOUTUBE_API_KEY=

# Local model via LM Studio (Developer tab → Start Server). When it is running,
# every lens except Grounded is generated locally, for free, on hover. Leave
# LMSTUDIO_MODEL blank to use whatever is loaded.
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=
LMSTUDIO_TIMEOUT=180

# Grounded (web-cited) answers, and the fallback when LM Studio is off.
ANTHROPIC_API_KEY=

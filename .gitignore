# ─────────────────────────────────────────────────────────────
# SECRETS & PERSONAL DATA — never commit. Keep this section first.
# ─────────────────────────────────────────────────────────────
# Env / secrets (all variants)
.env
.env.*
!.env.example
*.env
secrets.*
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
*token*
*secret*
!*.example

# Your private learning material (books, notes) — stays local until you say otherwise
backend/content/library/
backend/content/generated.json
backend/content/vault_questions.json
# What fetch_reading.py fetched, and what failed. Derived from the bank plus the
# state of the web on the day it ran — regenerate it, do not share it.
backend/content/reading_fetch.json

# Answers a LOCAL model wrote. The curated bank in content/answers/ ships with
# the repo; these are this machine's LM Studio output, cached under __local so it
# cannot shadow the Claude one, and they are not the same kind of thing.
backend/content/answers/*__local.md

# And the verdict on them. Derived from those files by eval_answers.py, so it is
# regenerated, never shared: a report about answers that are not in the repo
# describes nothing in another clone.
backend/content/answers/_eval.md
backend/content/answers/_eval.json

# Scraper output cache (may contain fetched third-party content)
backend/data/resources.json

# User-exported progress / notes dumps
*.progress.json
# Anchored. Unanchored, `notes/` matches at ANY depth, and it was silently
# swallowing frontend/src/components/notes/ — GraphView.tsx, the whole Notes
# graph feature, never entered the repo, so a fresh clone did not build.
/notes/
*.notes.md

